{
  "name": "inkbothy",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "Lukasz Chrost (lukost)",
  "description": "A deliberately simple static site generator: Markdown in, a deployable directory out.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/client && tsc --noEmit -p tests",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && npm run typecheck && vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@mozilla/readability": "0.6.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@shikijs/langs": "4.6.0",
    "@shikijs/themes": "4.6.0",
    "htmlparser2": "12.0.0",
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0",
    "mermaid": "12.3.0",
    "minisearch": "7.2.0",
    "shiki": "4.6.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
